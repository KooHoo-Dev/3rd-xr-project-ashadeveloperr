  m_text: "\uD3F4 \uB05D\uC774 \uB208\uC5D0 \uB2FF\uC73C\uBA74 \uD1A1 \uB5A8\uB9BC
    \xB7 \uB2FF\uC740 \uCC44 \uB4A4\uB85C \uBC00\uAE30: \uCD9C\uBC1C \xB7 \uC591\uC190\uC744
    \uB3CC\uB9B0 \uCABD\uC73C\uB85C \uD68C\uC804 \xB7 \uC606\uC73C\uB85C \uAEBE\uC73C\uBA74
    \uAC10\uC18D\n\uBA48\uCDC4\uC744 \uB54C \uC67C\uCABD \uC2A4\uD2F1 \uAC77\uAE30\xB7\uC624\uB978\uCABD
