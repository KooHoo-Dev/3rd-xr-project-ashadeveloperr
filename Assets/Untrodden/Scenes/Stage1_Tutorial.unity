  m_text: "\uD3F4 \uB05D\uC744 \uB208\uC5D0 \uB300\uBA74 \uD1A1 \uB5A8\uB9BC \xB7
    \uB2FF\uC740 \uCC44 \uB4A4\uB85C \uBC00\uAE30: \uCD9C\uBC1C(\uCC98\uC74C \uD55C
    \uBC88\uC740 \uC2AC\uB85C\uD504\uAE4C\uC9C0 \uBD80\uC2A4\uD2B8) \xB7 \uD55C \uC190\uB9CC
    \uBC00\uBA74 \uBC18\uB300\uB85C \uB3CC\uBA70 \uAC00\uC18D\n\uC591\uC190\uC744
    \uB3CC\uB9B0 \uCABD\uC73C\uB85C \uD68C\uC804(\uD06C\uAC8C \uAEBE\uC73C\uBA74
    \uAC10\uC18D) \xB7 \uC810\uD504 \uCC29\uC9C0: \uD3F4\uC744 \uB4E4\uACE0 \uC9C4\uD589
    \uBC29\uD5A5\uC744 \uAC00\uB9AC\uD0A4\uAE30\n\uC81C\uD55C\uC2DC\uAC04 \uC548\uC5D0
    \uACB0\uC2B9\uC120 \uD1B5\uACFC \xB7 \uB193\uCE5C \uAD00\uBB38 +5\uCD08 \xB7
    \uB9C9\uD788\uBA74 \uC67C\uCABD \uBA54\uB274 \uBC84\uD2BC \uAE38\uAC8C: \uCF54\uC2A4\uB85C
    \uBCF5\uADC0"
